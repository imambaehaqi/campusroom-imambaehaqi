generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOSEN
}

enum StatusPengajuan {
  MENUNGGU
  DISETUJUI
  DITOLAK
  SELESAI
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(DOSEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  peminjaman Peminjaman[]

  @@map("users")
}

model Ruang {
  id           Int      @id @default(autoincrement())
  externalId   String?  @unique // id dari webservice api-ruangan, kalau ada
  nama         String
  lokasi       String?
  kapasitas    Int      @default(0)
  deskripsi    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  peminjaman Peminjaman[]

  @@map("ruang")
}

model Peminjaman {
  id          Int             @id @default(autoincrement())
  ruangId     Int
  userId      Int
  keperluan   String
  tanggalMulai   DateTime
  tanggalSelesai DateTime
  status      StatusPengajuan @default(MENUNGGU)
  catatanAdmin String?        @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  ruang Ruang @relation(fields: [ruangId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([ruangId, tanggalMulai, tanggalSelesai])
  @@map("peminjaman")
}